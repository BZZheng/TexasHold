# Copy to deploy/deploy.env (ignored by Git) or export these variables.
# Every hostname and path below is a non-routable example or generic placeholder.
TEXAS_HOLDEM_SERVER_HOST=server.example.com
TEXAS_HOLDEM_SERVER_USER=deploy
TEXAS_HOLDEM_SERVER_KEY=/srv/texas-holdem-secrets/deploy.key
TEXAS_HOLDEM_SERVER_ROOT=/srv/texas-holdem
TEXAS_HOLDEM_PRODUCTION_ENV_FILE=deploy/production.env
# Optional: a docker-save tar or gzip archive for servers without registry access.
TEXAS_HOLDEM_PREBUILT_IMAGE_FILE=
TEXAS_HOLDEM_PUBLIC_HEALTH_URL=https://play.example.com/api/health
TEXAS_HOLDEM_ALLOW_LEGACY_UPGRADE=0
