# Copy to a target-specific *.env file and keep that copy outside Git.
# No external database is required; DATA_DIR holds private runtime JSON state.
NODE_ENV=production
PORT=7790
DATA_DIR=/srv/texas-holdem/data
APP_ORIGINS=https://play.example.com
APP_BIND_IP=127.0.0.1
APP_PORT=7790
DATA_HOST_DIR=/srv/texas-holdem/data
NODE_IMAGE=node:22-bookworm-slim
COOKIE_SECURE=true
ALLOW_NO_ORIGIN=false
TRUST_PROXY=loopback
ARCHIVE_RING_MAX_BYTES=268435456
STORAGE_MIN_FREE_BYTES=1073741824

# Structured logs remain bounded on the application server. Remote archival is
# optional and never runs in the gameplay request path.
LOG_ENABLED=true
LOG_LEVEL=info
LOG_DIR=/srv/texas-holdem/data/logs
LOG_STDOUT=true
LOG_FILE_MAX_BYTES=5242880
LOG_ROTATE_INTERVAL_MS=900000
LOG_ARCHIVE_MAX_BYTES=52428800
LOG_ARCHIVE_MAX_FILES=12
LOG_QUEUE_MAX_ENTRIES=5000
LOG_FLUSH_INTERVAL_MS=250
LOG_ARCHIVE_MODE=disabled
LOG_ARCHIVE_DIR=
LOG_ARCHIVE_READY_FILE=
LOG_ARCHIVE_SYNC_INTERVAL_MS=30000
LOG_ARCHIVE_STALE_AFTER_MS=300000
APP_RELEASE=production
INSTANCE_ID=

# Compose container path and Make service controls.
CONTAINER_LOG_DIR=/data/logs
APP_HOST=127.0.0.1
SERVICE_LOG_DIR=.logs
SERVICE_RUN_DIR=.run
