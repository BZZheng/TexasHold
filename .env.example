# Local development defaults. Copy to .env; never commit the copied file.
# This application does not require an external database or DATABASE_URL.
# Local JSON state is written below DATA_DIR, which is ignored by Git.
NODE_ENV=development
PORT=7790
DATA_DIR=./data/local
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:7790,http://localhost:7790
COOKIE_SECURE=false
ALLOW_NO_ORIGIN=false
TRUST_PROXY=loopback

# Keep local limits representative of production.
ARCHIVE_RING_MAX_BYTES=268435456
HAND_ANALYSIS_RING_MAX_BYTES=536870912
STORAGE_MIN_FREE_BYTES=1073741824

# Structured application logs. LOG_DIR remains inside the ignored data tree.
LOG_ENABLED=true
LOG_LEVEL=debug
LOG_DIR=./data/local/logs
LOG_STDOUT=true
LOG_FILE_MAX_BYTES=5242880
LOG_ROTATE_INTERVAL_MS=900000
LOG_ARCHIVE_MAX_BYTES=52428800
LOG_ARCHIVE_MAX_FILES=12
LOG_QUEUE_MAX_ENTRIES=5000
LOG_FLUSH_INTERVAL_MS=250
LOG_ARCHIVE_MODE=disabled
LOG_ARCHIVE_DIR=
LOG_ARCHIVE_READY_FILE=
LOG_ARCHIVE_SYNC_INTERVAL_MS=30000
LOG_ARCHIVE_STALE_AFTER_MS=300000
APP_RELEASE=dev
INSTANCE_ID=

# Docker path and local Make service controls (not consumed by the Node server).
CONTAINER_LOG_DIR=/data/logs
APP_HOST=127.0.0.1
APP_PORT=7790
SERVICE_LOG_DIR=.logs
SERVICE_RUN_DIR=.run
